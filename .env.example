# Backend API Configuration
#
# Where the DRF backend LIVES decides the URL. Check with:
#     docker compose -p budget-tracker ps
#
# ############################################################################
# #  DRF IN DOCKER (the current setup) -- BFF in Docker too                   #
# #                                                                          #
# #     DRF_API_BASE_URL=http://web:8000/api/v1                              #
# #                                                                          #
# #  `web` is the DRF project's service name. The `bff` service joins that    #
# #  project's network (see `networks:` at the end of docker-compose.yml), so #
# #  Compose's DNS resolves it. Requires the DRF project to be running:       #
# #     docker compose -p budget-tracker up -d                                #
# #                                                                          #
# #  This needs NO host port publishing, which is the point: the API is not   #
# #  reachable from the LAN or any host interface, and no DRF setting has to  #
# #  be loosened to make it work.                                             #
# ############################################################################
#
# ############################################################################
# #  BFF RUNNING DIRECTLY ON THE HOST (not in Docker)                         #
# #                                                                          #
# #     DRF_API_BASE_URL=http://localhost:8000/api/v1                        #
# #                                                                          #
# #  Correct here because the host publishes DRF on 127.0.0.1:8000 and the    #
# #  BFF shares the host's loopback. `web` does NOT resolve outside Docker.   #
# ############################################################################
#
# ############################################################################
# #  WHY NOT THE LAN IP?  e.g. http://192.168.2.103:8000/api/v1              #
# #                                                                          #
# #  It does not work against the current DRF setup, for two independent     #
# #  reasons -- both verified rather than assumed:                           #
# #                                                                          #
# #  1. The DRF container publishes as `127.0.0.1:8000:8000` (WEB_BIND_ADDRESS #
# #     in the DRF project's .env). That binds the HOST side to loopback, so #
# #     nothing off-host can reach it:                                       #
# #         from a container, via 192.168.2.103:8000 -> connection refused    #
# #         from a container, via web:8000            -> 200 OK               #
# #     Note that gunicorn INSIDE the DRF container already binds 0.0.0.0.    #
# #     The blocker is the publish, not the server.                          #
# #                                                                          #
# #  2. Django would reject the request anyway: DJANGO_ALLOWED_HOSTS is      #
# #     `localhost,127.0.0.1,web`, which does not include the LAN IP.        #
# #                                                                          #
# #  Making it work means setting WEB_BIND_ADDRESS=0.0.0.0 and widening       #
# #  ALLOWED_HOSTS -- exposing a DJANGO_DEBUG=true API on every host          #
# #  interface, i.e. the whole LAN. Use the service name instead.             #
# ############################################################################
DRF_API_BASE_URL=http://web:8000/api/v1
DRF_API_BASE_URL=http://<YOUR-LAN-IP>:8000/api/v1

# --- Nextcloud document uploads --------------------------------------------
#
# NEXTCLOUD_UPLOAD_PATH is a PATH on THIS app's origin, not a Nextcloud URL.
# The app resolves it against whatever origin it is being served from, so one
# value works locally and behind the proxy in production. It is also the URL
# stored as a document's `file_url`.
#
# An absolute URL is accepted only when it points at this app's own origin; a
# cross-origin value is rejected with an explanation, because it would put the
# upload back into the CORS preflight the same-origin design exists to avoid.
NEXTCLOUD_UPLOAD_PATH=/nextcloud-dav/rentals

# ---------------------------------------------------------------------------
# UPLOAD MODE
# ---------------------------------------------------------------------------
# false -- PRODUCTION. The browser PUTs the file to NEXTCLOUD_UPLOAD_PATH and
#          the reverse proxy streams it straight to Nextcloud. File bytes never
#          touch Flask (AGENTS.md, rule 6). Needs the `caddy` service.
#
# true  -- LOCAL DEV ONLY. The browser POSTs the file to a Flask route which
#          forwards it to Nextcloud. This BREAKS RULE 6; every byte crosses the
#          BFF, so an upload occupies a worker and the BFF must be healthy for
#          uploads to work. It exists to unblock development when the proxy
#          path is the broken part.
#
# To be explicit about what it does NOT fix: it avoids no CORS problem that the
# proxy path did not already avoid. Both are same-origin from the browser's
# point of view, so neither triggers a preflight and neither needs a credential
# in the browser. A Flask hop cannot rescue a cross-origin design because this
# is not one.
#
# The credential stays server-side in BOTH modes. The stored `file_url` is
# identical either way, so a document uploaded through the fallback is
# indistinguishable downstream.
#
# MUST be false in production. See src/rentals/interfaces/web/upload_proxy.py.
NEXTCLOUD_UPLOAD_VIA_BFF=false

# --- Nextcloud credentials -------------------------------------------------
#
# Used in both modes and never sent to the browser in either:
#   proxy mode -> Caddy injects it as `Authorization: Basic`.
#   fallback   -> Flask reads it from here and injects it upstream.
#
# There are deliberately no NEXTCLOUD_USERNAME / NEXTCLOUD_PASSWORD settings.
# Two earlier designs sent the App Password from the browser; both are recorded
# in AGENTS.md and both leaked it to every signed-in user.
#
# ############################################################################
# #  REQUIRED PROXY CONFIGURATION (only for NEXTCLOUD_UPLOAD_VIA_BFF=false)    #
# #                                                                          #
# #  The reverse proxy in front of THIS app forwards the upload path to       #
# #  Nextcloud and injects the credential, so the browser sends no            #
# #  Authorization header and the file never reaches Flask. The shipped       #
# #  Caddyfile uses an explicit matcher:                                         #
# #                                                                          #
# #      @nextcloud_upload path /nextcloud-dav/rentals/*                       #
# #      handle @nextcloud_upload {                                            #
# #          uri strip_prefix /nextcloud-dav/rentals                           #
# #          rewrite * /remote.php/dav/files/bff-uploader/rentals{uri}         #
# #          reverse_proxy https://cloud.example {                             #
# #              header_up Authorization "Basic {env.NEXTCLOUD_BASIC_AUTH}"    #
# #          }                                                                #
# #      }                                                                    #
# #                                                                          #
# #  `handle_path /nextcloud-dav/rentals/* { ... }` is an equivalent          #
# #  shorthand for the matcher plus `uri strip_prefix`. Both leave the         #
# #  filename in {uri}; verified against Caddy, not assumed.                  #
# #                                                                          #
# #  NEXTCLOUD_BASIC_AUTH is base64("<username>:<app-password>") and lives    #
# #  only in the proxy's environment -- never in this application.            #
# #                                                                          #
# #  docker-compose.yml puts `caddy` behind a compose profile, so plain       #
# #  `docker compose up` does NOT start it. Bring it up explicitly with:      #
# #      docker compose --profile proxy up                                    #
# ############################################################################
#
# base64("<username>:<app-password>"). Create the App Password in Nextcloud
# under Settings -> Security -> Devices; it is shown ONCE, at creation. Scope it
# to writing the uploads folder only, using a dedicated non-admin account.
#     printf '%s' 'bff-uploader:the-app-password' | base64
#
# Lives in your gitignored .env, never in docker-compose.yml or a template.
NEXTCLOUD_BASIC_AUTH=

# --- Nextcloud destination (fallback mode only) ----------------------------
#
# Read only when NEXTCLOUD_UPLOAD_VIA_BFF is true, because Flask is then the one
# making the request. In proxy mode Caddy learns the destination from its own
# reverse_proxy target, so these can stay empty.
#
# DAV_PATH is the WebDAV collection, i.e. where the file lands:
#     /remote.php/dav/files/<user>/<folder>
NEXTCLOUD_BASE_URL=
NEXTCLOUD_DAV_PATH=

# Flask Security Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-string-in-production
FLASK_DEBUG=true
