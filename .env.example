# Backend API Configuration
DRF_API_BASE_URL=http://localhost:8000/api/v1

# Nextcloud direct upload (rentals documents).
#
# The browser PUTs files straight to Nextcloud; the BFF only ever receives the
# resulting URL. This is a PUBLIC SHARE (drop folder), so there are exactly two
# settings and no credentials:
#
#   NEXTCLOUD_WEBDAV_BASE_URL  the share's WebDAV root
#   NEXTCLOUD_SHARE_TOKEN      authenticates as the username, empty password
#
# There is deliberately NO NEXTCLOUD_USERNAME / NEXTCLOUD_PASSWORD. Anything
# sent from the browser is readable in the DOM by every user who loads the page,
# so an account password would be disclosed to all of them. The share token is
# scoped to one folder and is revocable by deleting the share. Keep it that way.
#
# Final upload path is:  <base>/<file name>
#   The token goes in the Authorization header ONLY. Verified against a live
#   Nextcloud: putting it in the path returns 401, and dropping the header also
#   returns 401 for both the PUT and its OPTIONS preflight.
#
# CORS: the upload is cross-origin, so the reverse proxy in front of Nextcloud
# must add CORS headers for /public.php/webdav/*, or the browser discards the
# response even though the request succeeded. See the "API Contract Management"
# section of AGENTS.md for the required headers.
NEXTCLOUD_WEBDAV_BASE_URL=https://...
NEXTCLOUD_SHARE_TOKEN=...

# Flask Security Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-string-in-production
FLASK_DEBUG=true
