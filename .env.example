# Backend API Configuration
DRF_API_BASE_URL=http://localhost:8000/api/v1

# --- Nextcloud document uploads --------------------------------------------
#
# Documents never pass through Flask (AGENTS.md, rule 6). The browser PUTs the
# file to a path on THIS app's origin; the reverse proxy forwards it to
# Nextcloud and injects the Authorization header itself.
#
# There are deliberately NO Nextcloud credentials in this file. Anything the
# browser sends is readable in the page source by every signed-in user, and the
# app used to render the App Password there. The proxy holds the credential now,
# so it never reaches a client.
#
# This also removes CORS entirely: the request is same-origin, so there is no
# preflight. That mattered -- a browser never sends `Authorization` on a CORS
# preflight, and Nextcloud answers that preflight with 401. Chromium happened
# to tolerate it; Firefox and Safari do not.
#
# ############################################################################
# #  REQUIRED PROXY CONFIGURATION (Caddy, in front of THIS app)              #
# #                                                                          #
# #  handle_path /nextcloud-dav/rentals/* {                                 #
# #      rewrite * /remote.php/dav/files/bff-uploader/rentals{uri}           #
# #      reverse_proxy nextcloud:80 {                                       #
# #          header_up Authorization "Basic {env.NEXTCLOUD_BASIC}"          #
# #      }                                                                   #
# #  }                                                                       #
# #                                                                          #
# #  NEXTCLOUD_BASIC is base64("<username>:<app-password>") and lives only   #
# #  in the proxy's environment -- never in this application.                #
# ############################################################################
#
# Creating the credential, in Nextcloud:
#   1. A dedicated user, e.g. `bff-uploader`: no admin rights, never used to
#      sign in interactively.
#   2. Settings -> Security -> Devices -> Generate an App Password. Nextcloud
#      shows it ONCE; copy it. Scope it to writing the uploads folder only.
#   3. Create a `rentals` folder in that account (Files app, or MKCOL).
#
# To compute NEXTCLOUD_BASIC:
#   printf '%s' 'bff-uploader:the-app-password' | base64
#
# After changing it: restart the proxy, then re-run `make test-e2e` and the
# document-upload journey. Do NOT verify with curl alone -- curl does not
# enforce CORS and cannot prove the browser flow works.
NEXTCLOUD_UPLOAD_PATH=/nextcloud-dav/rentals

# Flask Security Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-string-in-production
FLASK_DEBUG=true
